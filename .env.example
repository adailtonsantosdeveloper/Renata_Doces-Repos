# Copie para ".env" e preencha. NUNCA coloque o ".env" no Git (ele já está no .gitignore).
# No servidor:  chmod 600 .env
#
# Evite ; = " ' $ e espaços nos valores (quebram a string de conexão e a leitura do arquivo).

# Domínio que aponta para o IP do servidor (ex.: doces.seudominio.com.br)
DOMAIN=

# Senha do administrador do SQL Server (só o app a usa; o banco não é exposto na internet).
# Mínimo 8 caracteres com maiúscula, minúscula e número. Sugestão: echo "Aa1-$(openssl rand -hex 16)"
SA_PASSWORD=

# Conta inicial do sistema (criada na primeira inicialização). Senha com no mínimo 10 caracteres.
AUTH_USUARIO=
AUTH_SENHA=

# Código exigido para criar novas contas na tela "Cadastre-se" (mínimo 10 caracteres).
AUTH_CODIGO_CONVITE=
