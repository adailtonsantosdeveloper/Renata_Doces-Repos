<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Id usado pelo "Manage User Secrets" do Visual Studio (credenciais locais fora do repositório) -->
		<UserSecretsId>renata-doces-7c1f4a52-3b8e-4d1a-9f60-2a5c8e1b7d34</UserSecretsId>
		<!-- Menos memória/threads em containers pequenos (Render, etc.) -->
		<ServerGarbageCollector>false</ServerGarbageCollector>
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
		<TieredPGO>false</TieredPGO>
		<!-- IIS (MonsterASP.NET): o app roda dentro do processo do IIS, o modo mais rápido e que usa menos memória -->
		<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!-- Devolve memória ao sistema com mais frequência (plano gratuito: 256 MB) -->
		<RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
